<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FalconCAD.App.ViewModels"
        xmlns:controls="using:FalconCAD.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="750"
        WindowState="Maximized"
        x:Class="FalconCAD.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding Title}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    </Window.KeyBindings>

    <Window.Styles>
        <Style Selector="Button.tool">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Padding" Value="6" />
            <Setter Property="Margin" Value="1" />
            <Setter Property="Background" Value="Transparent" />
        </Style>
        <Style Selector="Button.tool Path">
            <Setter Property="Stroke" Value="{Binding $parent[Button].Foreground}" />
            <Setter Property="StrokeThickness" Value="1.6" />
            <Setter Property="Stretch" Value="Uniform" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="_Open..." InputGesture="Ctrl+O" Click="OnOpen" />
                <Separator />
                <MenuItem Header="E_xit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" Command="{Binding RunTextCommand}" CommandParameter="UNDO" />
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" Command="{Binding RunTextCommand}" CommandParameter="REDO" />
                <Separator />
                <MenuItem Header="_Delete" Command="{Binding RunTextCommand}" CommandParameter="DELETE" />
            </MenuItem>
            <MenuItem Header="_Draw">
                <MenuItem Header="_Net" Command="{Binding RunTextCommand}" CommandParameter="NET" />
                <MenuItem Header="_Wire" Command="{Binding RunTextCommand}" CommandParameter="WIRE" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="_Fit" Command="{Binding RunTextCommand}" CommandParameter="WINDOW FIT" />
                <MenuItem Header="Zoom _in" Command="{Binding RunTextCommand}" CommandParameter="WINDOW 2" />
                <MenuItem Header="Zoom _out" Command="{Binding RunTextCommand}" CommandParameter="WINDOW 0.5" />
                <MenuItem Header="_Grid on/off" Command="{Binding RunTextCommand}" CommandParameter="GRID" />
            </MenuItem>
        </Menu>

        <!-- Main toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,2" Spacing="2">
            <Button Classes="tool" ToolTip.Tip="Open (Ctrl+O)" Click="OnOpen">
                <Path Data="M3,6 H9 L11,8 H21 V19 H3 Z" />
            </Button>
            <ComboBox ItemsSource="{Binding SheetNames}" SelectedIndex="{Binding SheetIndex}"
                      ToolTip.Tip="Sheet (EDIT .s2)" MinWidth="70" VerticalAlignment="Center" Margin="4,0" />
            <Button Classes="tool" ToolTip.Tip="Undo (Ctrl+Z)" Command="{Binding RunTextCommand}" CommandParameter="UNDO">
                <Path Data="M8,5 L3,10 L8,15 M3,10 H15 A5,5 0 0 1 15,20 H11" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Redo (Ctrl+Y)" Command="{Binding RunTextCommand}" CommandParameter="REDO">
                <Path Data="M16,5 L21,10 L16,15 M21,10 H9 A5,5 0 0 0 9,20 H13" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Fit (WINDOW FIT)" Command="{Binding RunTextCommand}" CommandParameter="WINDOW FIT">
                <Path Data="M3,9 V3 H9 M15,3 H21 V9 M21,15 V21 H15 M9,21 H3 V15" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Zoom in (WINDOW 2)" Command="{Binding RunTextCommand}" CommandParameter="WINDOW 2">
                <Path Data="M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 M15,15 L21,21 M7,10 H13 M10,7 V13" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Zoom out (WINDOW 0.5)" Command="{Binding RunTextCommand}" CommandParameter="WINDOW 0.5">
                <Path Data="M10,3 A7,7 0 1 1 10,17 A7,7 0 1 1 10,3 M15,15 L21,21 M7,10 H13" />
            </Button>
        </StackPanel>

        <!-- Parameter toolbar -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,4,2" Spacing="6">
            <Button Classes="tool" ToolTip.Tip="Grid on/off (GRID)" Command="{Binding RunTextCommand}" CommandParameter="GRID">
                <Path Data="M3,8 H21 M3,16 H21 M8,3 V21 M16,3 V21" />
            </Button>
            <TextBlock Text="Layer:" VerticalAlignment="Center" />
            <ComboBox ItemsSource="{Binding Layers}" SelectedItem="{Binding ActiveLayer}" MinWidth="160" />
        </StackPanel>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Padding="6,3">
            <TextBlock Text="{Binding Status}" />
        </Border>

        <!-- Tool palette -->
        <StackPanel DockPanel.Dock="Left" Margin="2">
            <Button Classes="tool" ToolTip.Tip="Net (NET)" Command="{Binding RunTextCommand}" CommandParameter="NET">
                <Path Data="M3,18 H12 V6 H21" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Wire (WIRE)" Command="{Binding RunTextCommand}" CommandParameter="WIRE">
                <Path Data="M4,20 L20,4" />
            </Button>
            <Button Classes="tool" ToolTip.Tip="Delete (DELETE)" Command="{Binding RunTextCommand}" CommandParameter="DELETE">
                <Path Data="M5,5 L19,19 M19,5 L5,19" />
            </Button>
        </StackPanel>

        <!-- Coordinates and command line -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*" Margin="2,0,2,2">
            <TextBlock Grid.Column="0" Text="{Binding Coordinates}" MinWidth="170"
                       VerticalAlignment="Center" Margin="4,0,8,0" />
            <TextBox Grid.Column="1" x:Name="CommandBox"
                     Text="{Binding CommandText}"
                     PlaceholderText="Type a command, e.g. NET (0 0) (1 0);"
                     FontFamily="Consolas">
                <TextBox.KeyBindings>
                    <KeyBinding Gesture="Enter" Command="{Binding RunCommandCommand}" />
                    <KeyBinding Gesture="Up" Command="{Binding HistoryPreviousCommand}" />
                    <KeyBinding Gesture="Down" Command="{Binding HistoryNextCommand}" />
                </TextBox.KeyBindings>
            </TextBox>
        </Grid>

        <controls:EditorCanvas x:Name="EditorView" Editor="{Binding Editor}" />
    </DockPanel>
</Window>
